{
  "type": "function",
  "function": {
    "name": "check_availability",
    "description": "Check open appointment slots for a service on a specific date, optionally for a specific barber.",
    "parameters": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "integer",
          "description": "The service ID (integer) from get_business_info."
        },
        "date": {
          "type": "string",
          "description": "Exact calendar date, YYYY-MM-DD."
        },
        "staff_id": {
          "type": "integer",
          "description": "Optional. Omit entirely if the caller has no barber preference."
        }
      },
      "required": ["service_id", "date"]
    }
  },
  "server": {
    "url": "https://booking-service-production-5815.up.railway.app/api/v1/voice-tools/check-availability/1",
    "headers": {
      "x-vapi-secret": "<set via Vapi credential, never commit>"
    }
  }
}
