# Copy to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development

# Supabase Postgres connection
# IMPORTANT: use the Shared Pooler (Supavisor) in SESSION mode, not the
# direct connection. Supabase's direct connection (db.<ref>.supabase.co)
# is IPv6-only by default, and most external hosts (Railway included)
# can't reach it -- this caused a real "Network is unreachable" outage
# during initial deployment. The pooler is always IPv4-compatible.
# Get this exact string from Supabase dashboard -> Connect -> Session pooler.
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase (for Storage/Auth calls that don't go through raw SQL)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vapi
# Shared secret Vapi sends on every tool call (see app/core/security.py) -- generate a long random value
VAPI_SHARED_SECRET=
# Only needed if the backend calls Vapi's own API (e.g. to sync assistant prompts)
VAPI_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic (only if the backend calls Claude directly, outside Vapi's own model config)
ANTHROPIC_API_KEY=
