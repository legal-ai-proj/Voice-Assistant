# Copy to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development

# Supabase Postgres direct connection (SQLAlchemy async driver)
# Get this from Supabase dashboard -> Project Settings -> Database -> Connection string (URI), then swap postgresql:// for postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase (for Storage/Auth calls that don't go through raw SQL)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vapi
# Shared secret Vapi sends on every tool call (see app/core/security.py) -- generate a long random value
VAPI_SHARED_SECRET=
# Only needed if the backend calls Vapi's own API (e.g. to sync assistant prompts)
VAPI_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic (only if the backend calls Claude directly, outside Vapi's own model config)
ANTHROPIC_API_KEY=
